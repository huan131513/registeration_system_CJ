generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model YearOption {
  id    String @id @default(cuid())
  value String @unique
}

model FolderLabel {
  id    String @id @default(cuid())
  key   String @unique  // e.g. "114年 春季"
  label String          // custom display name
}

model CourseOption {
  id    String @id @default(cuid())
  value String @unique
}

model LotteryRun {
  id                 String   @id @default(cuid())
  courseName         String
  year               String   @default("")
  semester           String   @default("")
  totalQuota         Int
  volunteerSlots     Int
  waitlistSlots      Int
  totalRegistrants   Int
  excludedCount      Int
  directAdmitCount   Int
  exemptionCount     Int
  createdAt          DateTime @default(now())

  results LotteryResult[]
}

model LotteryResult {
  id             String     @id @default(cuid())
  lotteryRunId   String
  lotteryRun     LotteryRun @relation(fields: [lotteryRunId], references: [id], onDelete: Cascade)

  name           String
  phone          String
  gender         String
  emergencyName  String
  emergencyPhone String
  age            String
  education      String
  admissionType  String
  order          Int

  @@index([lotteryRunId])
}
